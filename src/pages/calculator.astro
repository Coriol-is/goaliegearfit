---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/content/Breadcrumbs.astro";
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Calculator" }];
---

<BaseLayout
  title="Goalie leg-pad size calculator | Goalie Gear Fit"
  description="Enter the measurement required by each reviewed brand chart for an honest goalie-pad size result."
  canonicalPath="/calculator/"
  {breadcrumbs}
  pageType="calculator"
  dateModified="2026-07-20"
>
  <Breadcrumbs items={breadcrumbs} />
  <header class="content">
    <p class="eyebrow">Manufacturer chart matching</p>
    <h1>Goalie leg-pad size calculator</h1>
    <p class="lede">
      Choose a brand and enter the exact measurement its reviewed chart uses.
      Your measurements stay in this browser.
    </p>
  </header>
  <div class="calculator-shell">
    <form id="calculator-form" class="calculator-form" novalidate>
      <label>
        Brand
        <select id="brand">
          <option>Bauer</option>
          <option>CCM</option>
          <option>TRUE</option>
          <option>Warrior</option>
          <option>Brian's</option>
          <option>Vaughn</option>
        </select>
      </label>
      <p id="coverage" role="status"></p>
      <p id="unsupported-route" hidden><a href="https://vaughnhockey.com/faq/">Vaughn official fitting support</a> — ask a retailer for an in-person fitting.</p>
      <fieldset id="units-field">
        <legend>Units</legend>
        <label class="inline">
          <input type="radio" name="unit" value="in" checked /> Inches
        </label>
        <label class="inline">
          <input type="radio" name="unit" value="cm" /> Centimetres
        </label>
      </fieldset>
      <label id="category-field">
        Product chart category
        <select id="category">
          <option value="">Choose category</option>
        </select>
      </label>
      <label id="primary-field">
        <span id="primary-label">Floor to knee</span>
        <input
          id="primary"
          type="number"
          min="0"
          step="any"
          inputmode="decimal"
          required
        />
        <small id="primary-help">Use the method named by the chart.</small>
      </label>
      <label id="height-field">
        <span id="height-label">Standing height</span>
        <input
          id="height"
          type="number"
          min="0"
          step="any"
          inputmode="decimal"
        />
      </label>
      <label id="ktt-field">
        <span id="ktt-label">Knee to thigh</span>
        <input id="ktt" type="number" min="0" step="any" inputmode="decimal" /><small id="ktt-help"></small>
      </label>
      <p id="form-error" class="error" role="alert"></p>
      <button class="button" type="submit">
        Calculate chart size
      </button>
      <p>
        <a href="/guides/how-to-measure-goalie-pads/">
          How to measure accurately
        </a>
      </p>
    </form>
    <section id="result" class="result-card" tabindex="-1" aria-live="polite">
      <p class="eyebrow">Your result</p>
      <h2 id="result-heading">Enter a measurement to begin</h2>
      <div id="result-body">
        <p>
          The calculator will explain the reviewed chart match and the physical
          fit check to perform next.
        </p>
      </div>
    </section>
  </div>
  <section class="card" aria-labelledby="comparison-heading">
    <h2 id="comparison-heading">Cross-brand comparison</h2>
    <p>
      Only brands using compatible measurements are calculated. Others explain
      what additional input is needed.
    </p>
    <div id="comparison" class="comparison-list">
      <p>Complete a calculation to compare supported brands.</p>
    </div>
  </section>
  <section class="card content">
    <h2>What the result means</h2>
    <p>
      A recommendation is a chart match, not a guarantee of physical fit.
      Adjacent sizes mean ranges overlap. Conflict and cannot-determine states
      stop rather than guess.
    </p>
    <p>
      <a href="/charts/">Review every supported brand chart</a> or{" "}
      <a href="/methodology/">
        learn how recommendations are matched and verified
      </a>
      .
    </p>
  </section>
  <script>
    import datasetJson from "../data/sizing/goalie-leg-pads-us-v0.1.json";
    import { recommend } from "../lib/engine/recommend";
    import type { Dataset } from "../lib/engine/types";
    import {
      brandInputs,
      buildInput,
      comparisonHtml,
      reasonCopy,
      resultExplanation,
      statusHeading,
      supportedPreset,
      toInches,
      coverageCopy,
      displayMeasurement,
      transitionMeasurements,
      validateMeasurements,
      resultMetadataHtml,
      measurementHelp,
    } from "../lib/calculator/ui";
    import {
      analyticsEvents,
      failClosedReason,
      sendAnalytics,
    } from "../lib/analytics";
    const form = document.querySelector<HTMLFormElement>("#calculator-form")!,
      brand = document.querySelector<HTMLSelectElement>("#brand")!,
      category = document.querySelector<HTMLSelectElement>("#category")!,
      primary = document.querySelector<HTMLInputElement>("#primary")!,
      height = document.querySelector<HTMLInputElement>("#height")!,
      ktt = document.querySelector<HTMLInputElement>("#ktt")!,
      result = document.querySelector<HTMLElement>("#result")!,
      heading = document.querySelector<HTMLElement>("#result-heading")!,
      body = document.querySelector<HTMLElement>("#result-body")!,
      error = document.querySelector<HTMLElement>("#form-error")!;
    const field = (id: string, show: boolean) => {
      const el = document.querySelector<HTMLElement>(id)!;
      el.hidden = !show;
      el.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
        "input,select",
      ).forEach((x) => (x.disabled = !show));
    };
    function configure() {
      const b = brand.value as keyof typeof brandInputs,
        c = brandInputs[b];
      document.querySelector("#primary-label")!.textContent =
        c.method === "floor_to_knee" ? "Floor to knee" : "Ankle to knee";
      const supported=b!=="Vaughn";
      field("#primary-field",supported);
      field("#units-field",supported);
      const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;submit.hidden=!supported;submit.disabled=!supported;
      document.querySelector<HTMLElement>("#unsupported-route")!.hidden=supported;
      field("#category-field", c.category);
      field("#height-field", c.height);
      field("#ktt-field", c.ktt);
      category.innerHTML = '<option value="">Choose category</option>';
      for (const value of b === "Bauer"
        ? ["YOUTH", "JUNIOR", "INTERMEDIATE", "SENIOR"]
        : b === "TRUE"
          ? ["JR", "INT", "SR"]
          : [])
        category.add(new Option(value, value));
    }
    let currentBrand = brand.value as keyof typeof brandInputs,
      unit: "in" | "cm" = "in";
    let canonical: { primary?: number; height?: number; ktt?: number } = {};
    const inputs = { primary, height, ktt };
    const comparison = document.querySelector<HTMLElement>("#comparison")!;
    function invalidate() {
      heading.textContent = "Calculate with your current measurements";
      body.textContent =
        "Inputs changed. Calculate again to see a current chart match.";
      comparison.textContent =
        "Complete a calculation to compare supported brands.";
      error.textContent = "";
    }
    function renderInputs() {
      for (const key of Object.keys(inputs) as (keyof typeof inputs)[])
        inputs[key].value = displayMeasurement(canonical[key], unit);
      document.querySelector("#primary-label")!.textContent =
        `${brandInputs[currentBrand].method === "floor_to_knee" ? "Floor to knee" : "Ankle to knee"} (${unit})`;
      document.querySelector("#primary-help")!.textContent=measurementHelp[currentBrand].primary;
      document.querySelector("#ktt-help")!.textContent=measurementHelp[currentBrand].ktt;
      document.querySelector("#coverage")!.textContent =
        coverageCopy[currentBrand];
      document.querySelector("#height-label")!.textContent =
        `Standing height (${unit})${currentBrand === "Warrior" ? " — optional" : ""}`;
      document.querySelector("#ktt-label")!.textContent =
        `Knee to thigh (${unit})${currentBrand === "Warrior" ? " — optional extension" : ""}`;
    }
    for (const key of Object.keys(inputs) as (keyof typeof inputs)[])
      inputs[key].addEventListener("input", () => {
        canonical[key] =
          inputs[key].value === ""
            ? undefined
            : toInches(Number(inputs[key].value), unit);
        invalidate();
      });
    category.addEventListener("change", invalidate);
    form
      .querySelectorAll<HTMLInputElement>('input[name="unit"]')
      .forEach((radio) =>
        radio.addEventListener("change", () => {
          unit = radio.value as "in" | "cm";
          renderInputs();
          invalidate();
        }),
      );
    brand.addEventListener("change", () => {
      const next = brand.value as keyof typeof brandInputs;
      canonical = transitionMeasurements(currentBrand, next, canonical);
      currentBrand = next;
      configure();
      renderInputs();
      invalidate();
      sendAnalytics({
        name: analyticsEvents.brandSelected,
        props: { brand: brand.value },
      });
    });
    const preset = supportedPreset(
      new URLSearchParams(location.search).get("brand"),
    );
    if (preset) brand.value = preset;
    currentBrand = brand.value as keyof typeof brandInputs;
    configure();
    renderInputs();
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      error.textContent = "";
      const selectedBrand = currentBrand,
        c = brandInputs[selectedBrand];
      const values = {
        primary: canonical.primary,
        height: c.height ? canonical.height : undefined,
        ktt: c.ktt ? canonical.ktt : undefined,
      };
      const validation = validateMeasurements(
        selectedBrand,
        values,
        category.value,
      );
      if (validation) {
        invalidate();
        error.textContent = validation;
        return;
      }
      const input = buildInput(selectedBrand, {
          ...values,
          category: category.value || undefined,
        }),
        out = recommend(datasetJson as Dataset, input);
      sendAnalytics({
        name: analyticsEvents.completed,
        props: { brand: brand.value, status: out.status },
      });
      if (["cannot_determine", "conflict"].includes(out.status))
        sendAnalytics({
          name: analyticsEvents.failClosed,
          props: {
            brand: brand.value,
            status: out.status,
            reason: failClosedReason(
              out.status,
              "reason" in out ? out.reason : undefined,
            ),
          },
        });
      heading.textContent = statusHeading(out);
      const sizes = out.sizes.length
        ? `<p>Base chart size</p><p class="result-size">${out.sizes.join(" or ")}</p>`
        : "";
      const why =
        out.status === "cannot_determine"
          ? reasonCopy[out.reason]
          : out.status === "conflict"
            ? "The entered measurements do not share a reviewed chart row."
            : "The measurements match the reviewed chart range.";
      const explanation = resultExplanation(datasetJson as Dataset, out);
      const extensionNote =
        selectedBrand === "Warrior" &&
        out.sizes.length &&
        values.ktt === undefined
          ? "<p>Base size only. Add optional knee-to-thigh to check a published thigh-rise extension.</p>"
          : "";
      body.innerHTML = `${sizes}${resultMetadataHtml(out)}<p>${why}</p>${extensionNote}${explanation ? `<details open><summary>Why this result</summary><p>${explanation}</p></details>` : ""}<p>${coverageCopy[selectedBrand]}</p><p><a href="/charts/${c.slug}/">Review the ${selectedBrand} size chart and source</a></p><h3>Physical verification</h3><ul><li>Wear skates and knee protection.</li><li>Confirm the knee lands securely on the block.</li><li>Stop if rotation or thigh rise interferes.</li></ul>`;
      comparison.innerHTML = comparisonHtml(
        datasetJson as Dataset,
        selectedBrand,
        {
          ...values,
          primary: values.primary!,
          category: category.value || undefined,
        },
      );
      sendAnalytics({
        name: analyticsEvents.comparisonUsed,
        props: { brand: brand.value, status: "rendered" },
      });
      result.focus();
    });
  </script>
</BaseLayout>
